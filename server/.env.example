# Copier en .env puis adapter. Ne JAMAIS committer .env (il contient les clés).

# --- Authentification (obligatoire) ---------------------------------------------
# Clés séparées par des virgules ; une par poste ou par utilisateur conseillé.
# Générer : docker compose run --rm stt-cpu murmure-server gen-key   (ou : uv run murmure-server gen-key)
MURMURE_API_KEYS=
# Alternative : fichier monté dans le conteneur, une clé par ligne.
# MURMURE_API_KEYS_FILE=/run/secrets/murmure_keys
# Usage strictement local sans clé (déconseillé) :
# MURMURE_ALLOW_NO_AUTH=1

# --- Modèle -----------------------------------------------------------------------
MURMURE_MODEL=large-v3-turbo
# auto | cuda | cpu
MURMURE_DEVICE=auto
# auto = float16 (GPU) / int8 (CPU). Autres : int8_float16 (GPU < 4 Go), float32…
MURMURE_COMPUTE_TYPE=auto
MURMURE_BEAM_SIZE=5
MURMURE_VAD_FILTER=true
# 0 = automatique
MURMURE_CPU_THREADS=0

# --- Charge ---------------------------------------------------------------------
MURMURE_MAX_CONCURRENCY=1
MURMURE_QUEUE_TIMEOUT_S=120
MURMURE_MAX_UPLOAD_MB=25
# Requêtes / minute / clé (0 = illimité)
MURMURE_RATE_LIMIT_PER_MINUTE=60

MURMURE_LOG_LEVEL=info
# Port publié sur 127.0.0.1 de l'hôte
MURMURE_HOST_PORT=8000

# --- Reverse proxy Caddy (profil « proxy ») -----------------------------------------
MURMURE_DOMAIN=stt.exemple.fr
ACME_EMAIL=admin@exemple.fr
